# 配置值仅作示例；此文件只负责保证部署配置项完整，不同步任何机器的真实值。
# 将此示例复制到 Docker 主机的 /opt/chat-web-account-service/.env。
# 真实 .env 仅保存在服务器，不要提交到 Git 仓库。

# 当前 Docker 主机特有的部署参数，复制后按实际端口和网络调整。
TZ=Asia/Shanghai
BIND_ADDRESS=0.0.0.0
HOST_PORT=3000
DOCKER_NETWORK=chat-web-infrastructure

# 登录验证码和可撤销会话使用 Redis；同一 Docker 网络默认使用基础设施容器名。
REDIS_HOST=chat-web-redis
REDIS_PORT=6379
REDIS_DATABASE=0
# Redis 开启 ACL 或密码时取消注释。
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace-with-redis-password
# TLS 或 Redis Cloud 可直接使用完整连接串。
# REDIS_URL=rediss://user:password@example.redis:6379/0

# Bearer Token 的 HMAC 密钥，至少32位；两台机器必须使用同一值。也可以删除此项并配置 Nacos security.jwt.secret。
JWT_SECRET=replace-with-at-least-32-random-characters

# 仅在需要覆盖 Nacos 数据库连接配置时取消注释。
# ACCOUNT_MYSQL_HOST=chat-web-mysql
# ACCOUNT_MYSQL_PORT=3306
# ACCOUNT_MYSQL_DATABASE=chat_web_account

# 启动阶段连接 Nacos 配置中心所必需的参数。
NACOS_SERVER=nacos:8848
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-account-service.yaml
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# Nacos 开启鉴权时取消注释并填写。
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=replace-with-nacos-password

# 将账号服务注册到 Nacos 服务发现，供网关按服务名访问。
NACOS_REGISTER_ENABLED=true
NACOS_REGISTER_REQUIRED=false
NACOS_SERVICE_NAME=chat-web-account-service
NACOS_GROUP=DEFAULT_GROUP
NACOS_REGISTER_PORT=3000

# 同一 Docker 网络内留空，服务会自动注册容器 IP；跨宿主机部署时填写其他节点可访问的 IP。
NACOS_REGISTER_IP=
# 当前节点标识，用于结构化日志区分部署环境。
DEPLOYMENT_ENVIRONMENT=production-home
