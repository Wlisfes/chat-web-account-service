# 将此示例复制到 Docker 主机的 /opt/chat-web-account-service/.env。
# 真实 .env 仅保存在服务器，不要提交到 Git 仓库。
# 容器时区，影响应用日志和进程时间显示。
TZ=Asia/Shanghai
# 宿主机监听地址；0.0.0.0 表示允许其他机器通过宿主机 IP 访问。
BIND_ADDRESS=0.0.0.0
# 宿主机对外端口，映射到容器内的 3000 端口。
HOST_PORT=3000
# 已存在的外部 Docker 网络；账号服务通过该网络访问 Nacos 等基础服务。
DOCKER_NETWORK=chat-web-infrastructure

# Nacos 服务地址，格式为 host:port；容器内使用 Nacos 的网络名称访问。
NACOS_SERVER=nacos:8848
# Nacos 命名空间 ID（不是命名空间显示名称）。
NACOS_NAMESPACE=0210cecf-114e-43e6-a260-1d4b263fb189
# 服务注册分组。
NACOS_GROUP=DEFAULT_GROUP
# 注册到 Nacos 的服务名称。
NACOS_SERVICE_NAME=chat-web-account-service
# 从 Nacos 配置中心读取的 Data ID。
NACOS_CONFIG_DATA_ID=chat-web-account-service.yaml
# Nacos 配置中心的配置分组。
NACOS_CONFIG_GROUP=DEFAULT_GROUP
