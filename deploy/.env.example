# Docker 部署环境变量；业务连接、Redis、JWT 和路由配置统一从云端 Nacos 读取。
# 真实 .env 仅保存在部署主机，不要提交到 Git 仓库。

# 应用启动参数。
NODE_ENV=production
PORT=5010

# Nacos 连接、鉴权和配置订阅参数。
NACOS_SERVER=10.66.0.1:8848
NACOS_SERVICE_NAME=chat-web-account-service
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-account-service.yaml
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-nacos-password
