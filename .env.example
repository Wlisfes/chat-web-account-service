# Node.js 运行环境；本地开发使用 development。
NODE_ENV=development
# 本地服务监听端口；使用 4000 避免与 Docker 部署端口 3000 冲突。
PORT=4000

# 可选：覆盖 Nacos 中仅在 Docker 网络可解析的 MySQL 地址；生产容器不要设置。
ACCOUNT_MYSQL_HOST=127.0.0.1
# 可选：本机 MySQL 映射端口；不设置时使用 Nacos 配置。
ACCOUNT_MYSQL_PORT=3306
# 可选：覆盖 Nacos 中的数据库名称；数据库仍需由外部 SQL 提前创建。
ACCOUNT_MYSQL_DATABASE=chat-web-account

# Nacos 服务地址，格式为 host:port；本地开发连接本机 Nacos。
NACOS_SERVER=127.0.0.1:8848
# Nacos 命名空间 ID（不是命名空间显示名称）。
NACOS_NAMESPACE=0210cecf-114e-43e6-a260-1d4b263fb189
# 服务注册分组。
NACOS_GROUP=DEFAULT_GROUP
# 注册到 Nacos 的服务名称。
NACOS_SERVICE_NAME=chat-web-account-service
# 从 Nacos 配置中心读取的 Data ID。
NACOS_CONFIG_DATA_ID=chat-web-account-service.yaml
# Nacos 配置中心的配置分组。
NACOS_CONFIG_GROUP=DEFAULT_GROUP
