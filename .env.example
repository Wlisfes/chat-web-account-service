# 配置值仅作示例；复制为 .env 后按实际环境填写。此文件只负责保证配置项完整。
# 本地运行环境。
NODE_ENV=development
PORT=4000

# JWT HMAC 密钥至少32位。本地开发可放在 .env；生产环境也可改由 Nacos security.jwt.secret 提供。
JWT_SECRET=replace-with-at-least-32-random-characters

# Account 独占 Redis index 0；禁止与其他业务服务复用 index。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0

# 本地 MySQL 不在 Docker 网络时才需要覆盖 Nacos 中的连接地址；账号仍由 Nacos 提供且只能访问 Account 库。
# ACCOUNT_MYSQL_HOST=127.0.0.1
# ACCOUNT_MYSQL_PORT=3306
# ACCOUNT_MYSQL_DATABASE=chat_web_account

# 启动阶段连接 Nacos 配置中心所必需的参数。
NACOS_SERVER=127.0.0.1:8848
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-account-service.yaml
NACOS_CONFIG_GROUP=DEFAULT_GROUP

# Nacos 开启鉴权时取消注释并填写。
# NACOS_USERNAME=nacos
# NACOS_PASSWORD=replace-with-nacos-password

# 本地服务注册到 Nacos 服务发现时使用的参数。
NACOS_REGISTER_ENABLED=true
NACOS_REGISTER_REQUIRED=false
NACOS_SERVICE_NAME=chat-web-account-service
NACOS_GROUP=DEFAULT_GROUP
NACOS_REGISTER_IP=127.0.0.1
NACOS_REGISTER_PORT=4000
# Docker 部署会自动预加载 OpenTelemetry；本机进程需要采集时，在启动前设置以下变量。
# NODE_OPTIONS=--require @opentelemetry/auto-instrumentations-node/register
# OTEL_SERVICE_NAME=chat-web-account-service
# OTEL_SERVICE_VERSION=local
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=none
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1
# OTEL_METRIC_EXPORT_INTERVAL=15000
# DEPLOYMENT_ENVIRONMENT=development-local
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=chat-web,deployment.environment.name=development-local
