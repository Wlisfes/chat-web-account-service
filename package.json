    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22",
        "yarn": ">=1.22 <2"
    },
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\"",
        "test": "yarn build && node --test test/*.test.cjs",
        "start": "nest start",
        "dev": "nest start --watch",
        "debug": "nest start --debug --watch",
        "start:prod": "node dist/main"
    },
    "dependencies": {
        "@nestjs/common": "11.2.3",
        "@nestjs/core": "11.2.3",
        "@nestjs/platform-express": "11.2.3",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.0.9",
        "@types/express": "5.0.6",
        "@types/node": "24.13.3",
        "prettier": "3.9.6",
        "source-map-support": "0.5.21",
        "ts-loader": "9.5.4",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.7.3"
    }
}
