{
    "name": "chat-web-account-service",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "install": "yarn install --ignore-scripts",
        "schema:update": "yarn upgrade @wlisfes/chat-web-base-schema --latest",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" \".github/workflows/*.yml\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \".github/workflows/*.yml\"",
        "password:hash": "yarn build && node scripts/hash-password.cjs",
        "legacy:migrate": "node dist/cli/migrate-legacy-platform.js",
        "legacy:consumer-migrate": "node dist/cli/migrate-legacy-consumer.js",
        "seed:consumer": "node dist/cli/seed-demo-consumer.js",
        "menu:repair-finance": "node dist/cli/repair-finance-menus.js",
        "menu:repair-crm": "node dist/cli/repair-crm-menus.js",
        "menu:repair-position": "node dist/cli/repair-position-menus.js",
        "menu:repair-datetask": "node dist/cli/repair-datetask-menus.js",
        "test": "yarn build && node --test test/*.test.cjs",
        "start": "nest start",
        "dev": "nest start --watch",
        "debug": "nest start --debug --watch",
        "start:prod": "node dist/main"
    },
    "dependencies": {
        "@faker-js/faker": "8.4.1",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "11.4.6",
        "@nestjs/typeorm": "11.0.3",
        "@wlisfes/chat-web-base-schema": "1.4.22",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "dotenv": "^16.6.1",
        "express": "5.2.1",
        "js-yaml": "^4.1.0",
        "mysql2": "3.23.3",
        "nacos": "^2.6.0",
        "redis": "6.2.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "svg-captcha": "1.4.0",
        "typeorm": "0.3.31"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3"
    }
}
